<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.personal.autoledger">

    <!-- 严格不声明 android.permission.INTERNET，保证100%纯离线运行 -->

    <!-- 监听与读取银行动账短信权限 -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- 弹出记账通知提醒权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:label="随手纯本地记账"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- 主界面：账单列表、收支汇总、搜索、正则测试与CSV导出 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 快速记账弹窗 Activity：捕获到消费/收入时弹出，填写“这笔钱用来干什么” -->
        <activity
            android:name=".QuickRecordActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar" />

        <!-- 1. 银行短信广播接收器 -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- 2. 微信/支付宝/短信 通知栏监听服务 -->
        <service
            android:name=".PaymentNotificationService"
            android:exported="true"
            android:label="随手记账通知监听"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 3. 微信/支付宝 支付成功页面无障碍服务 -->
        <service
            android:name=".PaymentAccessibilityService"
            android:exported="true"
            android:label="随手记账支付页面识别"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
